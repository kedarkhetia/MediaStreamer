    {
      "id": "o8_1DU29C9iSlBZgifnbK",
      "type": "text",
      "x": 1167.7300205889292,
      "y": 351.33652101409336,
      "width": 215.49197142946022,
      "height": 128.7842707226319,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
