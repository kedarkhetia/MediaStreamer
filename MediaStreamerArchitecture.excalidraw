      "isDeleted": false,
      "boundElements": [],
      "updated": 1759889527947,
      "link": null,
      "locked": false,
      "text": "NonFunctional Requirements:",
      "fontSize": 33.30636039355549,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NonFunctional Requirements:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m1AEmJpnmS5VvCAGkYh8U",
      "type": "text",
      "x": 1165.6223750514139,
      "y": 528.5814200683461,
      "width": 734.9144680477677,
      "height": 180.29797901168462,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBK",
      "roundness": null,
      "seed": 739869428,
      "version": 1182,
      "versionNonce": 1587340660,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759889527947,
      "link": null,
      "locked": false,
      "text": "1. Low latency for movies.\n2. Scalable (Multiple users should be able to concurrently see the videos)\n3. More reads than writes (1,000,000:1 read to write ratio)\n4. Support large videos (10GB per movie)\n5. Resumable uploads (we will see about that)\n\n",
      "fontSize": 20.6054833156211,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low latency for movies.\n2. Scalable (Multiple users should be able to concurrently see the videos)\n3. More reads than writes (1,000,000:1 read to write ratio)\n4. Support large videos (10GB per movie)\n5. Resumable uploads (we will see about that)\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
