    },
    {
      "id": "sSlNdgjNSmF3BL6r0I04y",
      "type": "text",
      "x": 940.7730304865435,
      "y": 1762.7371219153702,
      "width": 744.99951171875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCO",
      "roundness": null,
      "seed": 206236276,
      "version": 883,
      "versionNonce": 1438139252,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760080920396,
      "link": null,
      "locked": false,
      "text": "This type of upload fails at multiple points:\n1. Network errors during upload require full restart (i.e. re-upload whole file).\n2. Design makes it difficult to manage videos and metadata.\n3. Large files can overwhelm the server by occupying all resources \n(Per our requirement 10GB file would need that amount of memory available\nin a single instance of upload movie service).\n4. Difficult to scale.\n5. Redundant as it requires same bytes to travel through\nnetwork twice.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This type of upload fails at multiple points:\n1. Network errors during upload require full restart (i.e. re-upload whole file).\n2. Design makes it difficult to manage videos and metadata.\n3. Large files can overwhelm the server by occupying all resources \n(Per our requirement 10GB file would need that amount of memory available\nin a single instance of upload movie service).\n4. Difficult to scale.\n5. Redundant as it requires same bytes to travel through\nnetwork twice.",
      "autoResize": true,
      "lineHeight": 1.25
    },
