    {
      "id": "OJlZ3TISmcV2giDL_tsgG",
      "type": "text",
      "x": 1321.6446780624915,
      "y": 2890.6408133454174,
      "width": 614.51953125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDu",
      "roundness": null,
      "seed": 506833396,
      "version": 923,
      "versionNonce": 1524316276,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760424763399,
      "link": null,
      "locked": false,
      "text": "Option-2: Client upload directly to S3 using multipart.\nRequires logic on frontend to chunk files and send it to\nS3 using multipart. Files are then merged on S3 to single\nobject and notification can be sent to serve. S3 also supports\nparallel/concurrent multipart uploads.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Option-2: Client upload directly to S3 using multipart.\nRequires logic on frontend to chunk files and send it to\nS3 using multipart. Files are then merged on S3 to single\nobject and notification can be sent to serve. S3 also supports\nparallel/concurrent multipart uploads.",
      "autoResize": true,
      "lineHeight": 1.25
    },
