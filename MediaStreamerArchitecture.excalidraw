      "seed": 608586444,
      "version": 382,
      "versionNonce": 1883763316,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759889527947,
      "link": null,
      "locked": false,
      "text": "1. Upload Videos\n2. Watch/View Videos\n3. Movie Catalog\n\n",
      "fontSize": 20.605483315621104,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Upload Videos\n2. Watch/View Videos\n3. Movie Catalog\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FnxlmtzVK690k_Yqya_Kk",
      "type": "text",
      "x": 1157.9257580878323,
      "y": 468.84905829037086,
      "width": 457.5914067358839,
      "height": 41.63295049194437,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
