    },
    {
      "id": "P6L7M7XckvetSyFZ-1ddi",
      "type": "text",
      "x": 1694.0896948142054,
      "y": 7569.289237446433,
      "width": 670.5795288085938,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGw",
      "roundness": null,
      "seed": 63572386,
      "version": 275,
      "versionNonce": 1533720226,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763437927472,
      "link": null,
      "locked": false,
      "text": "Optimize memory by using pipedInputStream and PipedOutputStream\nThat way no data will be stored in local disk and minimal data will be\nstored in memory.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Optimize memory by using pipedInputStream and PipedOutputStream\nThat way no data will be stored in local disk and minimal data will be\nstored in memory.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DCG1AI4X1pvXuHtzt1cyC",
      "type": "text",
      "x": 390.61168485279427,
      "y": 7576.596806647554,
      "width": 425.79974365234375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGx",
      "roundness": null,
      "seed": 236937954,
      "version": 328,
      "versionNonce": 736072290,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763437927472,
      "link": null,
      "locked": false,
      "text": "CDNs can store most popular content along\nwith metadata. That way if the content is\nnot found in CDN client can request the\ncontent from server. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CDNs can store most popular content along\nwith metadata. That way if the content is\nnot found in CDN client can request the\ncontent from server. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4dwdJAuJUnSpxLt93oRkN",
      "type": "text",
      "x": 1058.6083753142311,
      "y": 7564.060675727366,
      "width": 550.9996337890625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGy",
      "roundness": null,
      "seed": 38511614,
      "version": 431,
      "versionNonce": 415430178,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1763437927472,
      "link": null,
      "locked": false,
      "text": "In ABS, depending on the network speed and congestion\nwe dynamically select the content quality to be served. \nThis is possible because of Media Source Extensions. \n\nWe can request the content from server and append the\ndata to MSE's source buffer for rendering.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In ABS, depending on the network speed and congestion\nwe dynamically select the content quality to be served. \nThis is possible because of Media Source Extensions. \n\nWe can request the content from server and append the\ndata to MSE's source buffer for rendering.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Sa_ilC2_PjEwMeNrsCMeu",
      "type": "rectangle",
      "x": 564.2221158711918,
      "y": 5703.803020507003,
      "width": 727.9565351565125,
      "height": 289.92196441619177,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
