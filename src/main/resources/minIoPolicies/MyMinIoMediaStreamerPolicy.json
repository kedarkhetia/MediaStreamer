{
  "Version" : "2012-10-17",
  "Statement" : [
    {
      "Effect" : "Allow",
      "Action" : ["s3:GetObject", "s3:PutObject", "s3:ListenBucketNotification"],
      "Resource" : ["arn:aws:s3:::videos/*", "arn:aws:s3:::video-metadata/*", "arn:aws:s3:::video-chunks/*"]
    },
    {
      "Effect" : "Allow",
      "Action" : ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource" : "arn:aws:s3:::*"
    }
  ]
}